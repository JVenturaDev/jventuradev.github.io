---
import type { Project } from "../types/project";
import ProjectMedia from "./ProjectMedia.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const primaryScreenshot = project.screenshots[0] ?? { label: "Project screenshot coming soon" };
const supportingScreenshots = project.screenshots.slice(1);
---

<section class="section" id="projects" aria-labelledby="featured-project-title">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow" data-i18n="featured.eyebrow">Featured project</p>
        <h2 id="featured-project-title">{project.title}</h2>
      </div>
      <ul class="status-list" aria-label="Project status" data-i18n-aria-label="status.label">
        <li class="status--featured" data-i18n="status.featured">Featured</li>
        <li class="status--active" data-i18n="status.finished">Finished</li>
        <li data-i18n="status.publicRepository">Public Repository</li>
        <li class="status--active" data-i18n="status.liveDemo">Live Demo</li>
      </ul>
    </div>

    <article class="featured-project">
      <div class="featured-project__media">
        <ProjectMedia screenshot={primaryScreenshot} ratio="wide" priority i18nKey="projects.calculator.media.0" />
        {supportingScreenshots.length > 0 && (
          <div class="featured-project__gallery">
            {supportingScreenshots.map((screenshot, index) => (
              <ProjectMedia screenshot={screenshot} ratio="technical" i18nKey={`projects.calculator.media.${index + 1}`} />
            ))}
          </div>
        )}
      </div>
      <div class="featured-project__content">
        <div class="featured-project__intro">
          <p class="project-role" data-i18n="projects.calculator.role">{project.role}</p>
          <p class="featured-project__summary" data-i18n="projects.calculator.summary">{project.summary}</p>
          <p data-i18n="projects.calculator.description">{project.description}</p>
          {project.challenge && (
            <div class="featured-project__challenge">
              <h3 data-i18n="featured.technicalChallenge">Technical challenge</h3>
              <p data-i18n="projects.calculator.challenge">{project.challenge}</p>
            </div>
          )}
        </div>
        <div class="featured-project__details">
          {project.highlights && (
            <div>
              <h3 data-i18n="featured.engineeringHighlights">Engineering highlights</h3>
              <ul class="feature-list">
                {project.highlights.map((highlight, index) => <li data-i18n={`projects.calculator.highlight.${index}`}>{highlight}</li>)}
              </ul>
            </div>
          )}
          <ul class="tag-list" aria-label="Technologies" data-i18n-aria-label="projects.technologiesLabel">
            {project.stack.map((technology) => <li>{technology}</li>)}
          </ul>
          {project.links && (
            <div class="button-row" role="group" aria-label={`${project.title} links`} data-i18n-aria-label="projects.calculator.linksLabel">
              {project.links.map((link, index) => (
                <a class:list={["button", { "button--primary": index === 0 }]} href={link.href}>
                  <span data-i18n={index === 0 ? "actions.liveDemo" : "actions.sourceCode"}>{link.label}</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .featured-project {
    display: grid;
    gap: clamp(var(--space-6), 4vw, var(--space-8));
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .featured-project__content {
    display: grid;
    gap: var(--space-7);
    padding: 0 clamp(0rem, 1.5vw, var(--space-4)) clamp(0rem, 1.5vw, var(--space-4));
  }

  .featured-project__media {
    display: grid;
    gap: var(--space-4);
  }

  .featured-project__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .featured-project__intro,
  .featured-project__details { display: grid; align-content: start; gap: var(--space-5); }
  .featured-project__content p, .featured-project__content h3, .featured-project__content ul { margin-block: 0; }

  .featured-project__summary {
    color: var(--color-text);
    font-size: var(--text-xl);
    font-weight: 750;
    line-height: 1.35;
  }

  .featured-project__challenge {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .featured-project__content h3 {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  @media (min-width: 58rem) {
    .featured-project__content {
      grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
    }
  }

  @media (max-width: 42rem) {
    .featured-project__gallery {
      grid-template-columns: 1fr;
    }
   }
</style>
