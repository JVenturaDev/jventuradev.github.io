---
import { contact } from "../data/contact";
import { profile } from "../data/profile";
import { withBase } from "../utils/paths";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <p class="eyebrow" data-i18n="hero.eyebrow">Frontend / Angular Developer</p>
    <h1 id="hero-title" data-i18n="hero.headline">{profile.heroHeadline}</h1>
    <p class="hero__summary" data-i18n="hero.subheadline">{profile.heroSubheadline}</p>
    <div class="button-row" role="group" aria-label="Portfolio actions" data-i18n-aria-label="hero.actionsLabel">
      <a class="button button--primary" href={withBase("#projects")} data-i18n="hero.viewProjects">View Projects</a>
      <a class="button" href={withBase("#contact")} data-i18n="hero.contact">Contact Me</a>
      <a
        class="button"
        href={withBase(contact.cvPath)}
        download
        aria-label="Download Jonathan Ventura CV (PDF)"
        data-i18n="actions.downloadCv"
        data-i18n-aria-label="actions.downloadCvLabel"
      >Download CV</a>
      <a class="text-link" href={contact.github}>GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4.5rem, 9vw, 7.5rem) clamp(4rem, 7vw, 6.5rem);
    border-bottom: 1px solid var(--color-border);
    background:
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px) calc(50% - 37.5rem) 0 / 5rem 100%,
      var(--color-canvas);
  }

  .hero__inner {
    max-width: var(--content-width);
    margin-inline: auto;
  }

  h1 {
    max-width: 13ch;
    margin: var(--space-3) 0 var(--space-5);
    font-size: var(--text-display);
    line-height: 0.96;
    letter-spacing: -0.055em;
  }

  .hero__summary {
    max-width: 46rem;
    margin: 0 0 var(--space-7);
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
  }

  @media (max-width: 42rem) {
    .hero {
      background: var(--color-canvas);
    }
  }
</style>
