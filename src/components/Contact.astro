---
import { contact } from "../data/contact";
import { withBase } from "../utils/paths";

const emailHref = `mailto:${contact.email}`;
const cvHref = withBase(contact.cvPath);
---

<section class="section section--accent" id="contact" aria-labelledby="contact-title">
  <div class="container contact-layout">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Let&rsquo;s build something thoughtful.</h2>
      <p class="contact-intro">
        I&rsquo;m open to job opportunities, collaboration, and thoughtful technical conversations.
      </p>
    </div>
    <div class="contact-action">
      <p>Get in touch</p>
      <div class="button-row" role="group" aria-label="Contact actions">
        <a class="button button--primary" href={emailHref}>Email Me</a>
        <a class="button" href={cvHref} download aria-label="Download Jonathan Ventura CV (PDF)">Download CV</a>
        <a class="button" href={contact.github}>GitHub</a>
      </div>
      <span>{contact.email}</span>
    </div>
  </div>
</section>

<style>
  .contact-layout {
    display: grid;
    gap: var(--space-7);
    padding-block: clamp(var(--space-5), 3vw, var(--space-7));
  }

  .contact-layout h2,
  .contact-intro {
    margin-block: 0;
  }

  .contact-intro {
    max-width: 38rem;
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .contact-action {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .contact-action p,
  .contact-action span {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-action span {
    color: var(--color-muted);
    letter-spacing: 0;
    text-transform: none;
  }

  @media (min-width: 52rem) {
    .contact-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(22rem, 0.8fr);
      align-items: end;
    }
  }
</style>
