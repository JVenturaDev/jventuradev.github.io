---
import { contact } from "../data/contact";
import { profile } from "../data/profile";
import { withBase } from "../utils/paths";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <p class="eyebrow">Frontend / Angular Developer</p>
    <h1 id="hero-title">{profile.heroHeadline}</h1>
    <p class="hero__summary">{profile.heroSubheadline}</p>
    <div class="button-row" role="group" aria-label="Portfolio actions">
      <a class="button button--primary" href={withBase("#projects")}>View Projects</a>
      <a class="button" href={withBase("#contact")}>Contact Me</a>
      <a class="text-link" href={contact.github}>GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(5rem, 12vw, 9rem);
  }

  .hero__inner {
    max-width: 64rem;
    margin-inline: auto;
  }

  h1 {
    max-width: 14ch;
    margin: var(--space-3) 0 var(--space-5);
    font-size: var(--text-display);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero__summary {
    max-width: 48rem;
    margin: 0 0 var(--space-7);
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
  }
</style>
