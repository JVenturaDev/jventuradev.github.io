---
interface Props {
  label: string;
  ratio?: "wide" | "portrait" | "technical";
  i18nKey?: string | undefined;
}

const { label, ratio = "wide", i18nKey } = Astro.props;
---

<figure class:list={["screenshot-placeholder", `screenshot-placeholder--${ratio}`]}>
  <div class="screenshot-placeholder__surface" aria-hidden="true">
    <span class="screenshot-placeholder__mark"></span>
    <span data-i18n="media.placeholder">Screenshot area reserved</span>
  </div>
  <figcaption data-i18n={i18nKey ? `${i18nKey}.label` : undefined}>{label}</figcaption>
</figure>

<style>
  .screenshot-placeholder {
    margin: 0;
  }

  .screenshot-placeholder__surface {
    display: grid;
    min-height: 10rem;
    place-items: center;
    align-content: center;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface-muted);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-align: center;
    text-transform: uppercase;
  }

  .screenshot-placeholder__mark {
    width: 2.5rem;
    height: 0.2rem;
    border-radius: 999px;
    background: var(--color-border-strong);
  }

  .screenshot-placeholder--wide .screenshot-placeholder__surface {
    aspect-ratio: 16 / 9;
  }

  .screenshot-placeholder--portrait .screenshot-placeholder__surface {
    aspect-ratio: 4 / 5;
  }

  .screenshot-placeholder--technical .screenshot-placeholder__surface {
    aspect-ratio: 16 / 8;
  }

  figcaption {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
