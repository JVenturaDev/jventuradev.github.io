---
import { contact } from "../data/contact";
import { profile } from "../data/profile";
import { withBase } from "../utils/paths";
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={withBase("#top")}>{profile.name}</a>
    <nav aria-label="Primary navigation">
      <ul class="site-header__nav">
        <li><a href={withBase("#projects")}>Projects</a></li>
        <li><a href={withBase("#about")}>About</a></li>
        <li><a href={withBase("#skills")}>Skills</a></li>
        <li><a href={withBase("#contact")}>Contact</a></li>
        <li><a href={contact.github}>GitHub</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-canvas) 92%, transparent);
    backdrop-filter: blur(0.75rem);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4.25rem;
  }

  .site-header__brand {
    color: var(--color-text);
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .site-header__brand::after {
    color: var(--color-accent);
    content: ".";
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(var(--space-3), 2vw, var(--space-5));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .site-header__nav a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 42rem) {
    .site-header {
      position: relative;
    }

    .site-header__inner {
      display: grid;
      gap: var(--space-2);
      padding-block: var(--space-3);
    }

    .site-header__nav {
      gap: var(--space-2) var(--space-5);
      line-height: 1.8;
    }
  }
</style>
