---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  favicon?: string;
  noindex?: boolean;
  titleKey?: string;
  descriptionKey?: string;
}

const { title, description, image, imageAlt, favicon, noindex = false, titleKey = "meta.title", descriptionKey = "meta.description" } = Astro.props;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en" data-i18n-title-key={titleKey} data-i18n-description-key={descriptionKey}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("portfolio-theme");
          if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
        } catch {
          // System preference remains active when storage is unavailable.
        }

        try {
          const language = localStorage.getItem("portfolio-language");
          document.documentElement.lang = language === "es" ? "es" : "en";
        } catch {
          document.documentElement.lang = "en";
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f7fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101514" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {image && <meta name="twitter:image" content={image} />}
    {image && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {favicon && <link rel="icon" href={favicon} />}
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content" data-i18n="ui.skipToContent">Skip to main content</a>
    <slot />
  </body>
</html>
