---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import Hero from "../components/Hero.astro";
import ProjectExperience from "../components/ProjectExperience.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Skills from "../components/Skills.astro";
import MobileFloatingNav from "../components/MobileFloatingNav.astro";
import { featuredProject, secondaryProjects } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Jonathan Ventura | Frontend & Angular Developer";
const description =
  "Portfolio of Jonathan Ventura, a frontend and Angular developer building reliable full-stack tools, TypeScript libraries, and cross-platform interfaces.";
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main id="main-content">
    <Hero />
    <FeaturedProject project={featuredProject} />
    <About />
    <ProjectGrid projects={secondaryProjects} />
    <Skills />
    <ProjectExperience />
    <Contact />
  </main>
  <SiteFooter />
  <MobileFloatingNav />
</BaseLayout>
